{
  "Port": 9876,// 端口配置
  "Elicitation": false, // 确认弹窗是否开启
  "ExecuteSql": false, // 是否允许执行 sql
  "Backup": {
    "AlterTable": true, // 修改表结构前备份
    "DropTable": true, // 删表前备份
    "TruncateTable": true, // 清空前备份
    "UpdateData": true, // 更新前备份
    "DeleteData": true, // 删除前备份
    "DropDatabase": true // 删库前备份
  }
}
