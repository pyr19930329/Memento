<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
      <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
      <PackageReference Include="SqlSugarCore" Version="5.1.4.215-preview13" />
    </ItemGroup>

    <ItemGroup>
      <None Update="appsettings.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Remove="__pycache__\**" />
      <None Remove="logs\**" />
      <None Remove=".gitignore" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="__pycache__\**" />
      <Compile Remove="logs\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="__pycache__\**" />
      <EmbeddedResource Remove="logs\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="__pycache__\**" />
      <Content Remove="logs\**" />
    </ItemGroup>

</Project>
